# ═══════════════════════════════════════════════════════════════════════
# Codex Config Repository — .gitignore
# Excludes all sensitive, ephemeral, and system-managed files
# ═══════════════════════════════════════════════════════════════════════

# ── Credentials & Secrets ─────────────────────────────────────────────
auth.json
*.key
*.pem
*.p12
*.pfx
.env
.env.*
credentials.json
secrets.*

# ── Session & State Data ──────────────────────────────────────────────
state_*.sqlite*
logs_*.sqlite*
installation_id
version.json
models_cache.json
.personality_migration
.last-cleanup
history.jsonl

# ── Runtime Directories ───────────────────────────────────────────────
shell_snapshots/
log/
cache/
.tmp/
tmp/
sessions/
plans/

# ── System Skills (bundled with Codex CLI) ────────────────────────────
skills/.system/

# ── Build & Dependencies ─────────────────────────────────────────────
node_modules/
*.tsbuildinfo
dist/
.turbo/

# ── OS files ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# ── Old migration file ───────────────────────────────────────────────
.gitignore.repo
